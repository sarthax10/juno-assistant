def wav_bytes(pcm, rate=SAMPLE_RATE):
    buf = io.BytesIO()
    with wave.open(buf, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(rate)
        w.writeframes(pcm)
    return buf.getvalue()


def write_tone_wav(path, notes, rate=44100, volume=0.28):
    """A chime with a soft attack and exponential tail — a click or a raw
    sine both read as 'error' to the ear."""
    frames = bytearray()
    for freq, dur in notes:
        n = int(rate * dur)
        for i in range(n):
            t = i / rate
            env = min(1.0, t / 0.012) * math.exp(-t * 7.5)
            s = math.sin(2 * math.pi * freq * t)
            s += 0.28 * math.sin(4 * math.pi * freq * t)
            frames += struct.pack("<h", int(max(-1, min(1, s * env * volume)) * 32767))
    with wave.open(path, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(rate)
        w.writeframes(bytes(frames))


def ensure_sounds():
    sounds = os.path.join(SHARE, "sounds")
    os.makedirs(sounds, exist_ok=True)
    specs = {
        # rising = "I'm listening", falling = "I'm done", low = "something broke"
        "wake.wav": [(659.25, 0.09), (987.77, 0.20)],
        "done.wav": [(987.77, 0.07), (659.25, 0.16)],
        "error.wav": [(311.13, 0.10), (233.08, 0.20)],
    }
    for name, notes in specs.items():
        path = os.path.join(sounds, name)
        if not os.path.exists(path):
            try:
                write_tone_wav(path, notes)
            except Exception as exc:
                log("sounds:", exc)
    return sounds


def rms_of(frame):
    samples = array.array("h")
    samples.frombytes(frame)
    if not samples:
        return 0.0
    total = 0
    for s in samples:
        total += s * s
    return math.sqrt(total / len(samples)) / 32768.0


class WakeWord:
    """A dedicated wake-word model, fed the microphone directly.

    Matching a name inside a whisper transcript was the wrong architecture:
    whisper is asked to write down everything anyone in the room said, and
    the name then has to survive that. Measured here, playing the wake phrase
    through the speakers, it did not — three attempts, three misses, one of
    them transcribed "I know your post is amazing".

    This model answers one question instead, in eight milliseconds, and was
    trained on noise. Same room, same speakers, same three attempts: 0.992,
    0.997, 0.998.
    """

    def __init__(self, cfg, on_detect):
        self.cfg = cfg
        self.on_detect = on_detect
        self.path = os.path.join(SHARE, "juno-wake")
        self.proc = None
        self.ready = False
        # Bounded: if the detector ever falls behind, drop frames rather than
        # block the thread that owns the microphone.
        self.frames = queue.Queue(maxsize=64)
        self.dropped = 0
        self.paused = False

    def available(self):
        return os.path.exists(self.path) and self.cfg.get("wakeModel")

    def env(self):
        env = dict(os.environ)
        env["JUNO_WAKE_MODELS"] = str(self.cfg.get("wakeModel", ""))
        env["JUNO_WAKE_ENGINE"] = str(self.cfg.get("wakeEngine", "sherpa"))
        env["JUNO_WAKE_PHRASES"] = str(self.cfg.get("wakePhrases", "HEY JARVIS"))
        env["JUNO_KWS_SCORE"] = str(self.cfg.get("wakeKwsScore", 4.0))
        env["JUNO_KWS_THRESHOLD"] = str(self.cfg.get("wakeKwsThreshold", 0.01))
        env["JUNO_WAKE_THRESHOLD"] = str(self.cfg.get("wakeThreshold", 0.5))
        env["JUNO_WAKE_COOLDOWN"] = str(self.cfg.get("wakeCooldownSeconds", 1.5))
        return env

    def start(self):
        if not self.available():
            log("wake: detector unavailable; falling back to transcript matching")
            return False
        try:
            self.proc = subprocess.Popen(
                [self.path], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                stderr=subprocess.PIPE, bufsize=0, env=self.env())
        except Exception as exc:
            log("wake: could not start detector:", exc)
            return False
        deadline = time.time() + 120
        while time.time() < deadline:
            if self.proc.poll() is not None:
                log("wake: detector exited during startup")
                return False
            line = self.proc.stderr.readline()
            if not line:
                break
            text = line.decode("utf-8", "replace").strip()
            # The worker names its engine on the ready line, so match the
            # prefix. An exact comparison here hung startup completely: the
            # daemon sat reading stderr for a word that never came.
            if text.startswith("READY"):
                self.ready = True
                log(f"wake: listening for {self.cfg.get('wakeWord')} "
                    f"({self.cfg.get('wakeModel')})")
                threading.Thread(target=self.feed, daemon=True).start()
                threading.Thread(target=self.listen, daemon=True).start()
                return True
            log("wake:", text[:140])
        log("wake: detector never signalled ready")
        return False

    def push(self, frame):
        # Nothing to detect once she is already awake, and the transcriber
        # needs every cycle this machine has.
        if not self.ready or self.paused:
            return
        try:
            self.frames.put_nowait(frame)
        except queue.Full:
            # A dropped frame is a hole in the middle of a phrase, and the
            # model sees a different phrase. Worth knowing about.
            self.dropped += 1
            if self.dropped % 50 == 1:
                log(f"wake: dropped {self.dropped} frames — detector is behind")

    def feed(self):
        while self.proc and self.proc.poll() is None:
            try:
                frame = self.frames.get(timeout=0.5)
            except queue.Empty:
                continue
            try:
                self.proc.stdin.write(frame)
            except Exception:
                return

    def listen(self):
        while self.proc and self.proc.poll() is None:
            line = self.proc.stdout.readline()
            if not line:
                return
            try:
                event = json.loads(line.decode("utf-8", "replace"))
            except Exception:
                continue
            if event.get("near"):
                log(f"wake: near miss ({event.get('score', 0):.2f}) — "
                    f"threshold is {self.cfg.get('wakeThreshold', 0.35)}")
                BUS.emit(t="wake_near", score=event.get("score", 0.0))
                continue
            self.on_detect(event.get("score", 0.0))

    def stop(self):
        if self.proc and self.proc.poll() is None:
            with contextlib.suppress(Exception):
                self.proc.terminate()


class Microphone(threading.Thread):
    """Reads raw PCM forever, runs the VAD, and hands finished utterances to
    the brain. Also publishes a smoothed level for the orb."""

    daemon = True

    def __init__(self, cfg, on_utterance, gate, wants_levels, listening=None,
                 on_frame=None):
        super().__init__(name="mic")
        self.cfg = cfg
        self.on_utterance = on_utterance
        self.gate = gate                 # callable -> bool, False = discard audio
        self.wants_levels = wants_levels # callable -> bool, drives the orb
        self.listening = listening or (lambda: False)
        self.on_frame = on_frame or (lambda frame: None)
        self.proc = None
        self.stop_flag = threading.Event()
        self.noise_floor = 0.004
        self.level = 0.0
        self.speaking = False
        self.preroll = []
        self.buffer = bytearray()
        self.silence_ms = 0
        self.speech_ms = 0
        self.peak = 0.0
        self.tick = 0
        self.last_frame_at = time.time()
        self.frames_seen = 0

    def stop(self):
        self.stop_flag.set()
        if self.proc and self.proc.poll() is None:
            with contextlib.suppress(Exception):
                self.proc.terminate()

    def spawn(self):
        cmd = ["pw-record", "--raw", "--rate", str(SAMPLE_RATE),
               "--channels", "1", "--format", "s16", "--latency", "20ms"]
        # Capture from a named device rather than "whatever is default".
        # The default input has silently moved to the headset jack three
        # times in this session — once from a script of mine, twice on its
        # own — and with nothing plugged in that jack is near-silent, so Juno
        # went deaf while every status light stayed green.
        source = self.cfg.get("micSource") or ""
        if source and source != "default":
            cmd += ["--target", source]
        cmd += ["-"]
        return subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, bufsize=0)

    def run(self):
        while not self.stop_flag.is_set():
            try:
                self.proc = self.spawn()
            except FileNotFoundError:
                log("mic: pw-record not found")
                BUS.emit(t="error", message="pw-record is missing; PipeWire is required.")
                return
            log("mic: capture started")
            self.last_frame_at = time.time()
            threading.Thread(target=self.watchdog, args=(self.proc,),
                             daemon=True).start()
            try:
                self.pump()
            except Exception as exc:
                log("mic: pump died:", exc)
            if self.stop_flag.is_set():
                return
            log("mic: capture ended, restarting in 1s")
            time.sleep(1.0)

    def watchdog(self, proc):
        """A capture that stops delivering does not raise anything — the read
        just never returns, and Juno goes deaf in total silence. This happened:
        PipeWire left the microphone node SUSPENDED with the stream still
        attached, and the daemon sat there for twenty minutes reporting
        "capture started" and hearing nothing. Killing the reader makes the
        outer loop respawn it, which reattaches to a live node.
        """
        stall = float(self.cfg.get("micStallSeconds", 12))
        while not self.stop_flag.is_set() and proc.poll() is None:
            time.sleep(2)
            if time.time() - self.last_frame_at < stall:
                continue
            log(f"mic: no audio for {stall:.0f}s — restarting capture")
            BUS.emit(t="mic_stalled")
            with contextlib.suppress(Exception):
                proc.terminate()
            return

    def pump(self):
        out = self.proc.stdout
        while not self.stop_flag.is_set():
            frame = self.read_exact(out, FRAME_BYTES)
            if frame is None:
                return
            self.consume(frame)

    @staticmethod
    def read_exact(stream, size):
        """A pipe hands back whatever is ready, which is routinely less than a
        full frame. Treating a short read as end-of-stream is how you get a
        capture loop that restarts forever."""
        chunks = bytearray()
        while len(chunks) < size:
            chunk = stream.read(size - len(chunks))
            if not chunk:
                return None
            chunks += chunk
        return bytes(chunks)

    def consume(self, frame):
        self.last_frame_at = time.time()
        # The wake detector sees the raw stream, ahead of the mute gate and
        # the VAD, because it does its own noise handling and needs
        # continuity to recognise a phrase.
        if not self.cfg.get("micMuted"):
            self.on_frame(frame)
        raw = rms_of(frame)
        # Attack fast, release slow: the orb should snap to your voice and
        # settle gently, not flicker.
        self.level = max(raw, self.level * 0.82)
        self.tick += 1
        # Twenty-five events a second is nothing to produce and a great deal
        # to parse. The overlay stays subscribed for the whole session, so
        # publishing levels unconditionally meant the shell burned a fifth of
        # a core redrawing an orb nobody was looking at.
        if self.tick % 2 == 0 and BUS.count() and self.wants_levels():
            headroom = max(self.noise_floor * 1.6, 0.015)
            excess = (self.level - self.noise_floor) / headroom
            BUS.emit(t="level", rms=round(max(0.0, min(1.0, excess)), 4))

        if not self.gate():
            self.reset_segment()
            return

        # A minimum-follower, run unconditionally. Gating it on "not speaking"
        # is a trap: if the floor ever starts below the room, the gate latches
        # open, `speaking` never clears, and the floor can never catch up.
        # Falling fast and rising slowly keeps it pinned to the quiet parts
        # whether or not anyone is talking.
        if self.frames_seen < 3:
            self.noise_floor = raw          # seed from the actual room
        elif raw < self.noise_floor:
            self.noise_floor += (raw - self.noise_floor) * 0.25
        else:
            self.noise_floor += (raw - self.noise_floor) * 0.0016
        self.noise_floor = max(0.0005, min(0.45, self.noise_floor))
        self.frames_seen += 1

        # Give the follower a moment to settle before trusting the gate.
        if self.frames_seen < 40:
            return

        start_gate = self.noise_floor * self.cfg["vadStartRatio"] + 0.004
        end_gate = self.noise_floor * self.cfg["vadEndRatio"] + 0.002

        if not self.speaking:
            self.preroll.append(frame)
            if len(self.preroll) > 15:            # 300ms of lead-in
                self.preroll.pop(0)
            if raw > start_gate:
                self.speaking = True
                self.buffer = bytearray(b"".join(self.preroll))
                self.preroll = []
                self.silence_ms = 0
                self.speech_ms = 0
                self.peak = raw
                BUS.emit(t="vad", speaking=True)
            return

        self.buffer += frame
        self.peak = max(self.peak, raw)

        # Endpointing relative to the speaker, not to the room.
        #
        # A gate derived only from the noise floor cannot close while music
        # is playing: the floor sits below the music, the music sits above
        # the gate, and the utterance runs until the length cap — which is
        # exactly "it never stops listening". Your voice is louder at the
        # microphone than anything coming out of the speakers, so the honest
        # signal that you stopped is the level falling well below your own
        # loudest moment, whatever the room is doing underneath.
        speaker_gate = self.peak * float(self.cfg["vadEndPeakRatio"])

        # Two different questions, two different gates. Whether this frame
        # contains voice at all decides if the utterance is long enough to
        # bother transcribing; whether it is still near your own peak decides
        # if you have stopped talking. Using the peak gate for both was a bug:
        # ordinary speech spends most of its time below half its own peak, so
        # the utterance never accumulated enough "speech" and every segment
        # was thrown away as too short.
        if raw > end_gate:
            self.speech_ms += FRAME_MS
        if raw > max(end_gate, speaker_gate):
            self.silence_ms = 0
        else:
            self.silence_ms += FRAME_MS

        cap = (self.cfg["vadMaxUtteranceMs"] if self.listening()
               else self.cfg["vadMaxWakeMs"])
        too_long = len(self.buffer) / (SAMPLE_RATE * 2) * 1000 >= cap
        if self.silence_ms >= self.cfg["vadSilenceMs"] or too_long:
            pcm = bytes(self.buffer)
            enough = self.speech_ms >= self.cfg["vadMinSpeechMs"]
            self.reset_segment()
            BUS.emit(t="vad", speaking=False)
            if enough:
                self.on_utterance(pcm)

    def reset_segment(self):
        self.speaking = False
        self.buffer = bytearray()
        self.preroll = []
        self.silence_ms = 0
        self.speech_ms = 0
        self.peak = 0.0


# -------------------------------------------------------------------- whisper

def whisper_env():
    """Arch's whisper-cpp is linked against libbluray.so.4 while the repos
    still ship soname 3. whisper never calls into it — it arrives as a
    transitive ffmpeg dependency for Blu-ray demuxing, which a WAV file never
    touches — so a private shim directory on LD_LIBRARY_PATH gets the binary
    loading without putting a fake soname in /usr/lib. The moment a real
    libbluray.so.4 exists, this stops being used.

    The proper fix is a full `sudo pacman -Syu`.
    """
    env = dict(os.environ)
    if any(os.path.exists(os.path.join(d, "libbluray.so.4"))
           for d in ("/usr/lib", "/usr/lib64", "/lib")):
        return env
    shim = os.path.join(SHARE, "libshim")
    if not os.path.isdir(shim):
        return env
    existing = env.get("LD_LIBRARY_PATH", "")
    env["LD_LIBRARY_PATH"] = shim + (":" + existing if existing else "")
    return env


class Whisper:
    """Speech recognition through a resident CTranslate2 worker.

    whisper.cpp was the first implementation and is still installed, but it
    needed thirty to a hundred seconds for a two-second Hindi clip on this
    machine: Devanagari tokenizes into far more tokens than Latin, whisper
    decodes one token at a time, and this CPU runs at 1.2 GHz. The same
    model under CTranslate2 int8 answers in about five, and detects the
    language per utterance so English and Hindi need no mode switch.

    The worker holds the model in memory. Starting it costs four seconds
    once, which is four seconds nobody waits for mid-conversation.
    """

    def __init__(self, cfg):
        self.cfg = cfg
        self.worker_path = os.path.join(SHARE, "juno-stt")
        self.proc = None
        self.lock = threading.Lock()
        self.ready = False
        self.last_language = ""
        self.last_no_speech = 0.0
        self.last_logprob = 0.0
        # Kept only as a fallback if the worker will not start.
        self.cli = (shutil.which("whisper-cli") or shutil.which("whisper"))

    def available(self):
        return os.path.exists(self.worker_path) or bool(self.cli)

    def env(self):
        env = dict(os.environ)
        env["JUNO_STT_MODEL"] = str(self.cfg.get("sttModel", "base"))
        env["JUNO_STT_COMPUTE"] = str(self.cfg.get("sttCompute", "int8"))
        env["JUNO_STT_THREADS"] = str(self.cfg.get("whisperThreads", 6))
        env["JUNO_STT_LANGUAGE"] = str(self.cfg.get("whisperLanguage", "auto"))
        env["JUNO_STT_PROMPT"] = str(self.cfg.get("whisperPrompt", ""))
        env["JUNO_STT_MODEL_HI"] = str(self.cfg.get("sttModelHindi", ""))
        env["JUNO_STT_MODEL_ACCURATE"] = str(self.cfg.get("sttModelAccurate", ""))
        env["JUNO_STT_HI_PROB"] = str(self.cfg.get("sttHindiMinProb", 0.55))
        return env

    def start(self):
        if not os.path.exists(self.worker_path):
            log("stt: worker missing; falling back to the whisper-cli path")
            self.ready = bool(self.cli)
            return self.ready
        try:
            self.proc = subprocess.Popen(
                [self.worker_path], stdin=subprocess.PIPE,
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                text=True, bufsize=1, env=self.env())
        except Exception as exc:
            log("stt: worker failed to launch:", exc)
            self.ready = bool(self.cli)
            return self.ready

        # The model download on first run can take a while; wait generously.
        deadline = time.time() + 600
        while time.time() < deadline:
            if self.proc.poll() is not None:
                log("stt: worker exited during startup")
                self.ready = bool(self.cli)
                return self.ready
            line = self.proc.stderr.readline()
            if not line:
                break
            if line.strip() == "READY":
                self.ready = True
                log(f"stt: {self.cfg.get('sttModel', 'base')} model resident "
                    f"({self.cfg.get('sttCompute', 'int8')}, "
                    f"{self.cfg.get('whisperThreads', 6)} threads)")
                threading.Thread(target=self.drain_errors, daemon=True).start()
                return True
            log("stt:", line.strip()[:160])
        log("stt: worker never signalled ready")
        self.ready = bool(self.cli)
        return self.ready

    def drain_errors(self):
        """Keep stderr moving so the worker never blocks on a full pipe."""
        while self.proc and self.proc.poll() is None:
            line = self.proc.stderr.readline()
            if not line:
                return
            text = line.strip()
            if text and text != "READY":
                log("stt:", text[:160])

    def stop(self):
        if self.proc and self.proc.poll() is None:
            with contextlib.suppress(Exception):
                self.proc.terminate()
                self.proc.wait(timeout=5)

    def transcribe(self, pcm, accurate=False):
        """`accurate` escalates to the Hindi model when the audio is Hindi.
        Waiting for the wake word does not need it — only the name has to be
        legible — so the expensive pass is reserved for actual commands."""
        if not self.ready:
            return ""
        if self.proc and self.proc.poll() is None:
            text = self.via_worker(pcm, accurate)
            if text is not None:
                return text
        return self.via_cli(pcm)

    def via_worker(self, pcm, accurate=False):
        tmp = os.path.join(RUNTIME, f"juno-{uuid.uuid4().hex}.wav")
        try:
            with open(tmp, "wb") as fh:
                fh.write(wav_bytes(pcm))
            with self.lock:
                self.proc.stdin.write(tmp + ("\tfull" if accurate else "") + "\n")
                self.proc.stdin.flush()
                line = self.proc.stdout.readline()
            if not line:
                return None
            data = json.loads(line)
            if data.get("error"):
                log("stt:", data["error"][:160])
            self.last_language = data.get("language") or ""
            self.last_no_speech = float(data.get("no_speech", 1.0))
            self.last_logprob = float(data.get("logprob", -10.0))
            return clean_transcript(data.get("text", ""))
        except Exception as exc:
            log("stt: worker request failed:", exc)
            return None
        finally:
            with contextlib.suppress(OSError):
                os.remove(tmp)

    def via_cli(self, pcm):
        if not self.cli:
            return ""
        tmp = os.path.join(RUNTIME, f"juno-{uuid.uuid4().hex}.wav")
        try:
            with open(tmp, "wb") as fh:
                fh.write(wav_bytes(pcm))
            out = subprocess.run(
                [self.cli, "-m", self.cfg["model"], "-t",
                 str(self.cfg["whisperThreads"]), "-nt",
                 "-l", str(self.cfg.get("whisperLanguage") or "auto"),
                 "--prompt", self.cfg.get("whisperPrompt") or "",
                 "-f", tmp],
                capture_output=True, text=True, timeout=180, env=whisper_env())
            return clean_transcript(out.stdout)
        except Exception as exc:
            log("stt: cli failed:", exc)
            return ""
        finally:
            with contextlib.suppress(OSError):
                os.remove(tmp)


NOISE_TOKENS = re.compile(r"\[[^\]]*\]|\([^)]*\)")


def clean_transcript(text):
    text = NOISE_TOKENS.sub(" ", str(text or ""))
    text = re.sub(r"\s+", " ", text).strip()
    # Whisper loves to hallucinate this on silence.
    if text.lower().strip(" .!") in ("thank you", "thanks for watching",
                                     "you", "bye", "so", "okay"):
        return ""
    return text


# ------------------------------------------------------------------ wake word

DEVANAGARI = re.compile(r"[\u0900-\u097f]")


def script_language(text):
    """Which language a piece of text is in, decided by the script it is
    written in. Whisper emits Devanagari for Hindi and Latin for English, so
    the answer is already in the transcript — no second classifier, no
    guessing from word lists, and it works on a single word."""
    return "hi" if DEVANAGARI.search(str(text or "")) else "en"


def normalize(text):
    # Devanagari has to survive this, or every Hindi wake word is erased
    # before the matcher ever sees it.
    return re.sub(r"[^a-z0-9 \u0900-\u097f]", " ", str(text).lower()).strip()


def wake_split(text, cfg):
    """Find the wake word and return (matched, whatever followed it).

    The remainder matters: "Juno, what's the weather" should answer the
    question rather than make you say it twice.

    Position is part of the evidence. A strong alias counts anywhere in the
    utterance, because a room with a television in it produces long segments
    where the wake word lands in the middle of someone else's sentence. A
    weak alias — "you know", "uno" — is ordinary English and only counts
    when the utterance opens with it.
    """
    words = normalize(text).split()
    if not words:
        return False, ""

    fuzz = float(cfg["wakeFuzz"])
    strong = [normalize(a) for a in cfg.get("wakeAliases") or [] if a]
    weak = [normalize(a) for a in cfg.get("wakeAliasesHead") or [] if a]

    def hit(candidate, alias, threshold):
        return (candidate == alias
                or difflib.SequenceMatcher(None, candidate, alias).ratio() >= threshold)

    def remainder_from(index):
        rest = words[index:]
        # A long tail is the room talking, not a command. Wake up and listen
        # properly instead of acting on the television.
        return " ".join(rest) if 0 < len(rest) <= 12 else ""

    # Weak aliases: opening words only. Three words matter — whisper renders
    # a bare "Juno" as "Do you know", which is three tokens, not one.
    for span in (3, 2, 1):
        if len(words) < span:
            continue
        head = " ".join(words[:span])
        for alias in weak:
            if len(alias.split()) == span and hit(head, alias, fuzz):
                return True, remainder_from(span)

    # Strong aliases: anywhere. Scan left to right so the earliest wake wins
    # and the command is everything after it.
    for start in range(len(words)):
        for span in (3, 2, 1):
            if start + span > len(words):
                continue
            candidate = " ".join(words[start:start + span])
            for alias in strong:
                if len(alias.split()) != span:
                    continue
                # Mid-sentence matches carry less context, so ask for more
                # confidence there than at the very start of an utterance.
                threshold = fuzz if start == 0 else max(fuzz, 0.88)
                if hit(candidate, alias, threshold):
                    return True, remainder_from(start + span)
    return False, ""


