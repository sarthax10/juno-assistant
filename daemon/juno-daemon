class Voice:
    """A resident text-to-speech engine feeding a resident speaker.

    Whichever engine is in use, the contract is the same: a line of text on
    stdin, raw mono s16 PCM on stdout. Keeping the process up matters — the
    models take seconds to load, and paying that between a question and its
    answer would be the most noticeable thing about Juno.

    Kokoro is preferred: it is a neural voice and sounds like a person.
    It also runs at roughly real time, so it reports exact sample counts on
    stderr rather than making the daemon guess when a sentence has ended.
    Piper is faster and flatter, and stands in when Kokoro is unavailable;
    espeak is the last resort and sounds like 1998.
    """

    def __init__(self, cfg):
        self.cfg = cfg
        self.espeak = shutil.which("espeak-ng") or shutil.which("espeak")

        self.kokoro_worker = os.path.join(SHARE, "juno-kokoro")
        self.kokoro_model = os.path.join(SHARE, "kokoro/kokoro-v1.0.onnx")
        self.kokoro_voices = os.path.join(SHARE, "kokoro/voices-v1.0.bin")

        venv_piper = os.path.join(SHARE, "venv/bin/piper")
        self.piper = venv_piper if os.path.exists(venv_piper) else (
            shutil.which("piper-tts") or shutil.which("piper"))
        # Arch's `piper` in [extra] is a mouse configurator, not a synthesizer.
        if self.piper and self.piper != venv_piper and not self.looks_like_tts(self.piper):
            self.piper = None

        self.engine = self.choose_engine()
        self.rate = 24000 if self.engine == "kokoro" else self.piper_rate()

        self.lock = threading.Lock()
        self.proc = None            # the synthesizer
        self.sink = None            # pw-play
        self.stopped = threading.Event()
        self.done = threading.Event()
        self.done_samples = 0
        self.pending = 0
        self.stream_samples = 0
        self.stream_started = 0.0
        self.bytes_out = 0
        self.last_byte_at = 0.0
        self.first_byte_at = 0.0
        self.discard = False

    # ------------------------------------------------------------ discovery

    def kokoro_ready(self):
        return all(os.path.exists(p) for p in
                   (self.kokoro_worker, self.kokoro_model, self.kokoro_voices))

    def choose_engine(self):
        want = str(self.cfg.get("voiceEngine", "auto")).lower()
        if want == "kokoro" and self.kokoro_ready():
            return "kokoro"
        if want == "piper" and self.piper:
            return "piper"
        if want == "espeak" and self.espeak:
            return "espeak"
        if self.kokoro_ready():
            return "kokoro"
        if self.piper and os.path.exists(self.cfg["voice"]):
            return "piper"
        return "espeak" if self.espeak else "none"

    @staticmethod
    def looks_like_tts(path):
        try:
            out = subprocess.run([path, "--help"], capture_output=True,
                                 text=True, timeout=6)
            blob = (out.stdout + out.stderr).lower()
            return "onnx" in blob or "espeak" in blob or "model" in blob
        except Exception:
            return False

    def piper_rate(self):
        try:
            with open(self.cfg["voice"] + ".json") as fh:
                return int(json.load(fh)["audio"]["sample_rate"])
        except Exception:
            return 22050

    def available(self):
        return self.engine != "none"

    # ------------------------------------------------------------ the engine

    def worker_command(self):
        if self.engine == "kokoro":
            return [self.kokoro_worker], self.kokoro_env()
        if self.engine == "piper":
            return [self.piper, "-m", self.cfg["voice"], "--output-raw"], None
        return None, None

    def kokoro_env(self):
        env = dict(os.environ)
        env["JUNO_KOKORO_MODEL"] = self.kokoro_model
        env["JUNO_KOKORO_VOICES"] = self.kokoro_voices
        env["JUNO_KOKORO_VOICE"] = str(self.cfg.get("kokoroVoice", "af_heart"))
        env["JUNO_KOKORO_VOICE_HI"] = str(self.cfg.get("kokoroVoiceHindi", "hf_alpha"))
        env["JUNO_KOKORO_SPEED_HI"] = str(self.cfg.get("kokoroSpeedHindi", 0.88))
        env["JUNO_KOKORO_HINDI"] = "1" if self.cfg.get("hindiVoice") else "0"
        env["JUNO_KOKORO_SPEED"] = str(self.cfg.get("kokoroSpeed", 1.0))
        return env

    def spawn_sink(self):
        return subprocess.Popen(
            ["pw-play", "--rate", str(self.rate), "--channels", "1",
             "--format", "s16", "--raw", "-"],
            stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, bufsize=0)

    def ensure(self):
        if self.engine in ("espeak", "none"):
            return False
        if self.proc and self.proc.poll() is None and \
           self.sink and self.sink.poll() is None:
            return True
        self.teardown()
        command, env = self.worker_command()
        if not command:
            return False
        try:
            self.proc = subprocess.Popen(
                command, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                stderr=subprocess.PIPE, bufsize=0, env=env)
            self.sink = self.spawn_sink()
        except Exception as exc:
            log("tts: could not start engine:", exc)
            self.teardown()
            return False
        self.stopped.clear()
        threading.Thread(target=self.pump_audio, name="tts-audio",
                         daemon=True).start()
        threading.Thread(target=self.pump_control, name="tts-control",
                         daemon=True).start()
        log(f"tts: {self.engine} engine warm at {self.rate} Hz")
        return True

    def pump_audio(self):
        proc, sink = self.proc, self.sink
        while not self.stopped.is_set():
            try:
                chunk = proc.stdout.read(4096)
            except Exception:
                return
            if not chunk:
                return
            self.bytes_out += len(chunk)
            self.last_byte_at = time.time()
            if not self.first_byte_at:
                self.first_byte_at = time.time()
                # The number the user actually experiences: silence between
                # asking and hearing the first word.
                if self.stream_started:
                    log(f"tts: first audio after "
                        f"{self.first_byte_at - self.stream_started:.1f}s")
            if self.discard:
                continue
            try:
                sink.stdin.write(chunk)
                sink.stdin.flush()
            except Exception:
                return

    def pump_control(self):
        """Kokoro reports exactly when a line is finished and how many samples
        it produced. Piper says nothing, and speak() falls back to watching
        for a pause in the audio."""
        proc = self.proc
        while not self.stopped.is_set():
            try:
                line = proc.stderr.readline()
            except Exception:
                return
            if not line:
                return
            text = line.decode("utf-8", "replace").strip()
            if text.startswith("DONE "):
                with contextlib.suppress(ValueError):
                    self.done_samples = int(text.split()[1])
                    self.stream_samples += self.done_samples
                self.pending = max(0, self.pending - 1)
                self.done.set()
            elif text.startswith("ERROR "):
                log("tts:", text)

    def teardown(self):
        self.stopped.set()
        for proc in (self.proc, self.sink):
            if proc and proc.poll() is None:
                with contextlib.suppress(Exception):
                    proc.kill()
        self.proc = self.sink = None

    def stop(self):
        """Barge-in: drop the audio still in flight without reloading the
        model. Only the speaker is replaced."""
        with self.lock:
            if not self.sink:
                return
            self.discard = True
            self.pending = 0
            self.done.set()
            if self.sink.poll() is None:
                with contextlib.suppress(Exception):
                    self.sink.kill()
            try:
                self.sink = self.spawn_sink()
            except Exception:
                self.teardown()

    # --------------------------------------------------------------- speak

    def begin_stream(self):
        """Start an utterance that will arrive in pieces."""
        self.stream_started = time.time()
        with self.lock:
            if not self.ensure():
                return False
            self.discard = False
            self.done.clear()
            self.done_samples = 0
            self.bytes_out = 0
            self.last_byte_at = 0.0
            self.first_byte_at = 0.0
            self.pending = 0
            self.stream_samples = 0
            return True

    def feed(self, text):
        """Hand one sentence to the synthesizer immediately. Speech starts on
        the first sentence instead of after the last, which is most of the
        wait the user actually feels."""
        text = spoken_form(text, self.cfg)
        if not text:
            return
        with self.lock:
            if not self.proc or self.proc.poll() is not None:
                return
            try:
                self.done.clear()
                self.pending += 1
                self.proc.stdin.write((text.replace("\n", ". ") + "\n").encode())
                self.proc.stdin.flush()
            except Exception as exc:
                log("tts: feed failed:", exc)

    def end_stream(self, timeout=180):
        """Wait for everything fed so far to finish synthesizing and playing."""
        started = time.time()
        while self.pending > 0 and time.time() - started < timeout:
            if self.discard:
                return
            if self.done.wait(timeout=0.3):
                self.done.clear()
        samples = self.stream_samples or (self.bytes_out // 2)
        if not samples:
            return
        duration = samples / self.rate
        origin = self.first_byte_at or started
        drain = float(self.cfg.get("ttsDrainSeconds", 0.5))
        log(f"tts: {duration:.2f}s audio streamed in {time.time() - started:.2f}s")

        # Playback ends at whichever comes later.
        #
        # If synthesis outran playback, audio is queued and finishes a full
        # duration after the first sample. If synthesis fell behind — which
        # it does here, "9.07s audio streamed in 16.01s" — the speaker was
        # starved and is still working through the tail well after that
        # point. Taking only the first estimate reopened the microphone into
        # the end of her own sentence, which came back as a command.
        deadline = max(origin + duration, (self.last_byte_at or origin)) + drain
        while time.time() < deadline:
            if self.discard:
                break
            time.sleep(0.05)

    def speak(self, text):
        """Blocking: returns once the last sample has actually been heard, so
        the caller knows when reopening the microphone is safe."""
        text = spoken_form(text, self.cfg)
        if not text or not self.cfg.get("speak", True):
            return
        if self.engine in ("kokoro", "piper") and self.speak_worker(text):
            return
        self.speak_espeak(text)

    def speak_worker(self, text):
        with self.lock:
            if not self.ensure():
                return False
            self.discard = False
            self.done.clear()
            self.done_samples = 0
            self.bytes_out = 0
            self.last_byte_at = 0.0
            self.first_byte_at = 0.0
            proc = self.proc
            try:
                # One line is one utterance, so newlines become sentences.
                proc.stdin.write((text.replace("\n", ". ") + "\n").encode())
                proc.stdin.flush()
            except Exception as exc:
                log("tts: write failed:", exc)
                self.teardown()
                return False

        started = time.time()
        if self.engine == "kokoro":
            # Exact: wait for the worker to say the line is fully synthesized.
            if not self.done.wait(timeout=180):
                log("tts: kokoro timed out")
                return self.bytes_out > 0
            samples = self.done_samples or (self.bytes_out // 2)
        else:
            # Piper is silent about progress, so watch for a pause in output.
            while time.time() - started < 90:
                time.sleep(0.08)
                if self.discard:
                    return True
                if self.last_byte_at and time.time() - self.last_byte_at > 0.35:
                    break
                if self.proc is None or self.proc.poll() is not None:
                    return False
            samples = self.bytes_out // 2
        if not samples:
            return False

        duration = samples / self.rate
        log(f"tts: {duration:.2f}s audio, synth took {time.time() - started:.2f}s")

        # When playback ends is a fact, not an estimate: it began at the
        # first byte handed to the speaker and runs for the length of the
        # audio. The previous version measured from when synthesis started,
        # so whenever synthesis ran slower than real time — which it does on
        # this machine — it concluded playback was already over and reopened
        # the microphone into Juno's own voice. She then transcribed herself
        # and answered it.
        origin = self.first_byte_at or started
        deadline = max(origin + duration, (self.last_byte_at or origin)) \
            + float(self.cfg.get("ttsDrainSeconds", 0.5))
        while time.time() < deadline:
            if self.discard:
                break
            time.sleep(0.05)
        return True

    def speak_espeak(self, text):
        if not self.espeak:
            return
        cmd = (f'{shell_quote(self.espeak)} -v en-us+f3 -s 165 -p 42 --stdout '
               f'2>/dev/null | pw-play -')
        try:
            proc = subprocess.Popen(["bash", "-c", cmd], stdin=subprocess.PIPE,
                                    stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL)
            with contextlib.suppress(Exception):
                proc.stdin.write(text.encode())
                proc.stdin.close()
            proc.wait()
        except Exception as exc:
            log("tts:", exc)


def shell_quote(s):
    return "'" + str(s).replace("'", "'\\''") + "'"


SPOKEN_AS = {
    # Kokoro reads this as "Shreynch". A phonetic respelling is the only
    # control it offers over pronunciation, and it applies to the spoken
    # audio only — the panel still shows the name spelled properly.
    # e.g. "shreyansh": "Shray-ahnsh"
}


def respell(text):
    for written, spoken in SPOKEN_AS.items():
        text = re.sub(rf"\b{re.escape(written)}\b", spoken, text, flags=re.IGNORECASE)
    return text


def drop_name(text, name):
    """Remove direct address from what is spoken.

    The instruction not to use the name works most of the time and slips
    exactly when a person would be least likely to do it — good news,
    sympathy. Stripping it here also takes the comma with it, so "Congrats,
    Sam! That's great" becomes "Congrats! That's great" rather than
    "Congrats, ! That's great".
    """
    if not name:
        return text
    n = re.escape(name)
    text = re.sub(rf"\s*,\s*{n}\b", "", text, flags=re.IGNORECASE)
    text = re.sub(rf"\b{n}\s*,\s*", "", text, flags=re.IGNORECASE)
    text = re.sub(rf"\s*\b{n}\b\s*", " ", text, flags=re.IGNORECASE)
    return re.sub(r"\s+([.!?,])", r"\1", text).strip()


def tts_clean(text):
    """Strip everything that sounds like punctuation soup when spoken."""
    text = re.sub(r"```.*?```", " (code omitted) ", str(text or ""), flags=re.S)
    text = re.sub(r"`([^`]*)`", r"\1", text)
    text = re.sub(r"^\s{0,3}#{1,6}\s*", "", text, flags=re.M)
    text = re.sub(r"\*\*([^*]+)\*\*", r"\1", text)
    text = re.sub(r"\*([^*]+)\*", r"\1", text)
    text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)
    text = re.sub(r"^\s*[-*+]\s+", "", text, flags=re.M)
    text = re.sub(r"https?://\S+", "a link", text)
    text = re.sub(r"\s+", " ", text).strip()
    return respell(text)[:1400]


def spoken_form(text, cfg):
    """What actually reaches the synthesizer."""
    return tts_clean(drop_name(str(text or ""), cfg.get("userName", "")))


def play(path):
    if not os.path.exists(path):
        return
    with contextlib.suppress(Exception):
        subprocess.Popen(["pw-play", path], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)


# --------------------------------------------------------------------- claude

class Claude:
    def __init__(self, cfg, daemon):
        self.cfg = cfg
        self.daemon = daemon
        self.binary = shutil.which("claude") or os.path.expanduser(
            "~/.local/share/mise/installs/claude/latest/claude")
        self.session_id = None
        self.last_turn = 0.0
        self.proc = None
        self.cancelled = False
        self.sentence_buffer = ""
        self.on_sentence = None

    def available(self):
        return bool(self.binary and os.path.exists(self.binary))

    def reset(self):
        self.session_id = None

    def cancel(self):
        self.cancelled = True
        if self.proc and self.proc.poll() is None:
            with contextlib.suppress(Exception):
                self.proc.terminate()

    def build_command(self, prompt, unguarded=False):
        cfg = self.cfg
        mode = cfg.get("autoMode", "scoped")
        cmd = [self.binary, "-p", prompt,
               "--output-format", "stream-json", "--verbose",
               "--include-partial-messages",
               "--append-system-prompt", cfg["systemPrompt"]]
        if mode == "ask":
            cmd += ["--permission-mode", "plan"]
        else:
            cmd += ["--permission-mode", "bypassPermissions"]
        if self.session_id and time.time() - self.last_turn < cfg["sessionIdleSeconds"]:
            cmd += ["--resume", self.session_id]
        if mode == "scoped" and not unguarded:
            settings = self.daemon.guard_settings_path
            if settings:
                cmd += ["--settings", settings]
        return cmd

    def ask(self, prompt, unguarded=False, on_sentence=None):
        """Run one turn, streaming events onto the bus. Returns the reply."""
        self.cancelled = False
        workspace = os.path.expanduser(self.cfg["workspace"])
        os.makedirs(workspace, exist_ok=True)
        cmd = self.build_command(prompt, unguarded)
        env = dict(os.environ)
        env["JUNO"] = "1"
        if unguarded:
            env["JUNO_UNGUARDED"] = "1"
        try:
            self.proc = subprocess.Popen(
                cmd, cwd=workspace, stdout=subprocess.PIPE,
                stderr=subprocess.PIPE, stdin=subprocess.DEVNULL,
                text=True, bufsize=1, env=env)
        except Exception as exc:
            BUS.emit(t="error", message=f"Could not start Claude: {exc}")
            return ""

        reply = []
        tools = {}
        self.sentence_buffer = ""
        self.on_sentence = on_sentence
        for line in self.proc.stdout:
            line = line.strip()
            if not line:
                continue
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            self.handle_event(event, reply, tools)
            self.flush_sentences()
        self.flush_sentences(final=True)
        err = ""
        with contextlib.suppress(Exception):
            err = self.proc.stderr.read() or ""
        code = self.proc.wait()
        self.proc = None
        if self.cancelled:
            return ""
        text = "".join(reply).strip()
        if code != 0 and not text:
            snippet = err.strip().splitlines()[-1] if err.strip() else f"exit {code}"
            BUS.emit(t="error", message=f"Claude failed: {snippet[:200]}")
            return ""
        self.last_turn = time.time()
        return text

    # A sentence ends at punctuation followed by a space, or at the end of
    # the reply. Anything shorter than this is not worth a synthesis call;
    # anything longer delays the first word out of the speaker.
    SENTENCE_END = re.compile(r"(.+?[.!?…।])(\s+|$)", re.S)

    def flush_sentences(self, final=False):
        """Hand finished sentences to the voice while Claude is still writing
        the rest. The reply used to be synthesized only after the last token
        arrived, so the user waited for generation and synthesis end to end
        rather than overlapping them."""
        if not self.on_sentence:
            return
        while True:
            match = self.SENTENCE_END.match(self.sentence_buffer)
            if not match:
                break
            sentence = match.group(1).strip()
            self.sentence_buffer = self.sentence_buffer[match.end():]
            if sentence:
                self.on_sentence(sentence)
        if final and self.sentence_buffer.strip():
            self.on_sentence(self.sentence_buffer.strip())
            self.sentence_buffer = ""

    def handle_event(self, event, reply, tools):
        kind = event.get("type")

        if kind == "system" and event.get("subtype") == "init":
            self.session_id = event.get("session_id") or self.session_id
            BUS.emit(t="session", id=self.session_id,
                     model=event.get("model", ""),
                     cwd=event.get("cwd", ""))
            return

        if kind == "stream_event":
            inner = event.get("event") or {}
            if inner.get("type") == "content_block_start":
                # A reply can arrive as several text blocks — one before a
                # tool call and one after. Without a break they run together
                # mid-sentence ("…command now.That got blocked").
                block = inner.get("content_block") or {}
                if block.get("type") == "text" and reply:
                    reply.append("\n\n")
                    BUS.emit(t="delta", text="\n\n")
                return
            if inner.get("type") == "content_block_delta":
                delta = inner.get("delta") or {}
                if delta.get("type") == "text_delta":
                    chunk = delta.get("text") or ""
                    if chunk:
                        reply.append(chunk)
                        self.sentence_buffer += chunk
                        BUS.emit(t="delta", text=chunk)
                elif delta.get("type") == "thinking_delta":
                    BUS.emit(t="thinking", text=delta.get("thinking") or "")
            return

        if kind == "assistant":
            for block in (event.get("message") or {}).get("content") or []:
                if block.get("type") == "tool_use":
                    tid = block.get("id") or uuid.uuid4().hex
                    name = block.get("name") or "tool"
                    tools[tid] = name
                    BUS.emit(t="tool", id=tid, name=name,
                             detail=tool_detail(name, block.get("input") or {}))
                elif block.get("type") == "text" and not reply:
                    # No partial stream arrived (older CLI): take the whole
                    # block so the UI still shows something.
                    chunk = block.get("text") or ""
                    if chunk:
                        reply.append(chunk)
                        BUS.emit(t="delta", text=chunk)
            return

        if kind == "user":
            for block in (event.get("message") or {}).get("content") or []:
                if block.get("type") != "tool_result":
                    continue
                tid = block.get("tool_use_id")
                ok = not block.get("is_error")
                body = block.get("content")
                if isinstance(body, list):
                    body = " ".join(str(b.get("text", "")) for b in body
                                    if isinstance(b, dict))
                body = str(body or "")
                if not ok:
                    hit = self.daemon.blocked_reason(body)
                    if hit:
                        BUS.emit(t="blocked", reason=hit, detail=body[:400])
                BUS.emit(t="tool_done", id=tid, ok=ok,
                         name=tools.get(tid, "tool"), summary=body[:240])
            return

        if kind == "result":
            BUS.emit(t="turn_meta",
                     duration=event.get("duration_ms", 0),
                     cost=event.get("total_cost_usd", 0),
                     turns=event.get("num_turns", 0),
                     error=bool(event.get("is_error")))


def tool_detail(name, payload):
    """One short human line per tool call — this is what scrolls past in the
    activity rail while Juno works."""
    def s(key, limit=90):
        return str(payload.get(key, ""))[:limit]

    if name == "Bash":
        return s("command", 120)
    if name in ("Read", "Write", "Edit", "NotebookEdit"):
        return os.path.basename(s("file_path")) or s("file_path")
    if name in ("Grep", "Glob"):
        return s("pattern")
    if name in ("WebSearch",):
        return s("query")
    if name in ("WebFetch",):
        return s("url")
    if name == "Task":
        return s("description")
    return s("description") or ""


# ---------------------------------------------------------------------- brain

IDLE, LISTENING, THINKING, SPEAKING = "idle", "listening", "thinking", "speaking"


class Juno:
    def __init__(self):
        self.cfg = load_config()
        self.sounds = ensure_sounds()
        self.state = IDLE
        self.state_since = time.time()
        self.jobs = queue.Queue()
        self.history = self.load_history()
        self.whisper = Whisper(self.cfg)
        self.voice = Voice(self.cfg)
        self.claude = Claude(self.cfg, self)
        self.wake = WakeWord(self.cfg, self.on_wake_word)
        self.mic = Microphone(self.cfg, self.on_utterance, self.mic_open,
                              self.wants_levels,
                              lambda: self.state == LISTENING,
                              self.wake.push)
        self.follow_until = 0.0
        # A follow-up window that re-arms after every answer is a loop: one
        # wake, then any noise becomes a command, and answering it opens the
        # window again. The chain is capped so Juno always returns to needing
        # her name.
        self.follow_turns = 0
        self.last_prompt = ""
        self.last_block = None
        self.hide_at = 0.0
        self.dropped_segments = 0
        # Raised for the whole time audio is leaving the speakers, plus a
        # tail for what is still in the room. Juno answering her own voice
        # is the classic failure of an always-listening assistant.
        self.tts_until = 0.0
        # Levels flow only while a UI says it is visible, and lapse on
        # their own if that UI dies without saying goodbye.
        self.levels_until = 0.0
        self.guard_settings_path = self.write_guard_settings()
        self.stopping = threading.Event()

    # ----------------------------------------------------------- persistence

    def load_history(self):
        try:
            with open(HISTORY_PATH) as fh:
                data = json.load(fh)
            return data[-60:] if isinstance(data, list) else []
        except Exception:
            return []

    def save_history(self):
        os.makedirs(STATE, exist_ok=True)
        tmp = HISTORY_PATH + ".tmp"
        with contextlib.suppress(Exception):
            with open(tmp, "w") as fh:
                json.dump(self.history[-60:], fh)
            os.replace(tmp, HISTORY_PATH)

    def remember(self, role, text):
        if not text:
            return
        self.history.append({"role": role, "text": text, "ts": time.time()})
        self.history = self.history[-60:]
        self.save_history()

    def write_guard_settings(self):
        """Scoped auto still means auto — the guard only stands between Juno
        and the handful of commands you can't take back."""
        if self.cfg.get("autoMode") != "scoped":
            return None
        guard = os.path.join(SHARE, "juno-guard")
        if not os.path.exists(guard):
            return None
        path = os.path.join(SHARE, "guard-settings.json")
        settings = {
            "hooks": {
                "PreToolUse": [{
                    "matcher": "Bash",
                    "hooks": [{"type": "command", "command": guard, "timeout": 10}],
                }]
            }
        }
        with contextlib.suppress(Exception):
            with open(path, "w") as fh:
                json.dump(settings, fh, indent=2)
            return path
        return None

    @staticmethod
    def blocked_reason(body):
        m = re.search(r"JUNO_BLOCKED:\s*(.+)", str(body or ""))
        return m.group(1).strip()[:160] if m else None

    # ------------------------------------------------------------ state ---

    # ------------------------------------------------------------- surface

    def shell_ipc(self, *args):
        """Best effort. A missing shell must never stall the brain thread."""
        with contextlib.suppress(Exception):
            subprocess.Popen(["omarchy-shell", *args],
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)

    def show_ui(self):
        if not self.cfg.get("autoShow", True):
            return
        self.shell_ipc("shell", "summon", self.cfg["pluginId"], "{}")

    def hide_ui(self):
        self.shell_ipc("shell", "hide", self.cfg["pluginId"])

    def write_state_file(self):
        """The bar widget watches this instead of holding a socket open."""
        path = os.path.join(RUNTIME, "juno-state.json")
        payload = {
            "state": self.state,
            "muted": bool(self.cfg.get("micMuted")),
            "speak": bool(self.cfg.get("speak", True)),
            "ts": time.time(),
        }
        with contextlib.suppress(Exception):
            tmp = path + ".tmp"
            with open(tmp, "w") as fh:
                json.dump(payload, fh)
            os.replace(tmp, path)

    def set_state(self, state):
        if state == self.state:
            return
        self.state = state
        self.state_since = time.time()
        # The detector keeps running while she speaks and while she thinks,
        # so her name can cut her off. Full barge-in on any speech would need
        # echo cancellation to tell the user apart from the speaker; the wake
        # word is the part that works without it, because her own replies
        # never contain it.
        with contextlib.suppress(Exception):
            self.wake.paused = state == LISTENING
        self.write_state_file()
        BUS.emit(t="state", state=state)
        if state == IDLE:
            self.hide_at = time.time() + self.cfg.get("autoHideSeconds", 25) \
                if self.cfg.get("autoHideSeconds", 25) else 0
        else:
            self.hide_at = 0
            self.show_ui()

    def wants_levels(self):
        return time.time() < self.levels_until

    def mic_open(self):
        """Whether raw audio should reach the VAD at all. Juno never listens
        to itself — that is how assistants end up in conversation with their
        own voice."""
        if self.cfg.get("micMuted"):
            return False
        if time.time() < self.tts_until:
            return False
        return self.state in (IDLE, LISTENING)

    def say(self, text):
        """The only way anything reaches the speakers. Holds the microphone
        shut for the duration and half a second past it, so the tail of a
        sentence in a live room cannot come back as a command."""
        self.tts_until = time.time() + 3600      # closed until proven open
        try:
            self.voice.speak(text)
        finally:
            # Reverb outlives the speaker. Half a second was not enough on
            # this desk; the tail of her own sentence was still arriving.
            self.tts_until = time.time() + float(self.cfg.get("micReopenDelay", 1.4))

    def snapshot(self):
        return {
            "t": "hello",
            "state": self.state,
            "history": self.history[-40:],
            "config": {
                "wakeWord": self.cfg["wakeWord"],
                "speak": bool(self.cfg.get("speak", True)),
                "micMuted": bool(self.cfg.get("micMuted")),
                "autoMode": self.cfg.get("autoMode", "scoped"),
                "workspace": self.cfg["workspace"],
            },
            "health": {
                "whisper": self.whisper.ready,
                "voice": self.voice.available(),
                "wake": self.wake.ready,
                "wakeDropped": self.wake.dropped,
                "voiceEngine": self.voice.engine,
                "claude": self.claude.available(),
                "model": str(self.cfg.get("sttModel", "base")) + " int8",
                "language": self.whisper.last_language or "—",
            },
        }

    # ------------------------------------------------------------ input ---

    def on_wake_word(self, score):
        """The detector fired. This is the reliable path in — it does not go
        through the audio queue, and it does not wait for a transcript."""
        if self.state == LISTENING:
            return
        log(f"wake: detected ({score:.2f}) in state {self.state}")

        if self.state in (THINKING, SPEAKING):
            # Being talked over is how people take a turn back. Stop mid
            # sentence, drop what was queued, and listen — finishing the
            # sentence first is the thing that makes an assistant feel like
            # it is reading at you rather than talking with you.
            log("wake: interrupted")
            BUS.emit(t="interrupted")
            self.claude.cancel()
            self.voice.stop()
            self.tts_until = 0.0
        elif time.time() < self.tts_until:
            return

        BUS.emit(t="wake", heard=str(self.cfg.get("wakeWord")), score=score)
        self.begin_listening()

    def on_utterance(self, pcm):
        seconds = len(pcm) / (SAMPLE_RATE * 2)
        if seconds < 0.20:
            return
        # A room with a television in it produces speech-shaped audio faster
        # than this CPU can transcribe it, so the queue grows without bound
        # and everything — including the thing you actually said — arrives
        # tens of seconds late. Keep only the newest segments; older ones
        # describe a moment that has already passed.
        while self.jobs.qsize() >= self.cfg.get("maxPendingSegments", 2):
            try:
                dropped = self.jobs.get_nowait()
                if dropped[0] == "audio":
                    self.dropped_segments += 1
            except queue.Empty:
                break
        self.jobs.put(("audio", (pcm, time.time())))

    def command(self, msg):
        cmd = msg.get("cmd")
        if cmd == "wake":
            # Handled inline, not queued. Push-to-talk exists precisely for
            # when the room is too loud for the wake word, which is exactly
            # when the audio queue is deepest — putting it behind that queue
            # made the one reliable way in unresponsive.
            #
            # It also interrupts. Pressing the key while she is talking means
            # "stop, I want to say something", the same as saying her name.
            if self.state in (THINKING, SPEAKING):
                log("wake: interrupted (key)")
                BUS.emit(t="interrupted")
                self.claude.cancel()
                self.voice.stop()
                self.tts_until = 0.0
            self.begin_listening(manual=True)
        elif cmd == "ask":
            text = str(msg.get("text") or "").strip()
            if text:
                # Typed questions are silent by default; --speak makes one
                # behave exactly like a spoken turn, which is the only way to
                # exercise the voice path without a microphone.
                self.jobs.put(("ask_spoken" if msg.get("speak") else "ask", text))
        elif cmd == "cancel":
            self.claude.cancel()
            self.voice.stop()
            self.set_state(IDLE)
            self.follow_until = 0
        elif cmd == "say":
            text = str(msg.get("text") or "").strip()
            if text:
                threading.Thread(target=self.say, args=(text,),
                                 daemon=True).start()
        elif cmd == "stop_speaking":
            self.voice.stop()
        elif cmd == "retry_unguarded":
            if self.last_prompt:
                self.jobs.put(("unguarded", self.last_prompt))
        elif cmd == "clear":
            self.history = []
            self.save_history()
            self.claude.reset()
            BUS.emit(t="cleared")
        elif cmd == "set":
            key, value = msg.get("key"), msg.get("value")
            if key in ("speak", "micMuted"):
                self.cfg[key] = bool(value)
                self.persist_config()
                self.write_state_file()
                BUS.emit(t="config", key=key, value=self.cfg[key])
        elif cmd == "levels":
            # Refreshed by the overlay while it is on screen; a stale claim
            # expires rather than streaming forever.
            self.levels_until = time.time() + 30 if msg.get("value") else 0.0
        elif cmd == "ping":
            BUS.emit(t="pong")
        elif cmd == "state":
            BUS.emit(**self.snapshot())

    def persist_config(self):
        with contextlib.suppress(Exception):
            with open(CONFIG_PATH) as fh:
                stored = json.load(fh)
        stored = stored if isinstance(stored, dict) else {}
        stored.update({"speak": self.cfg.get("speak", True),
                       "micMuted": self.cfg.get("micMuted", False)})
        with contextlib.suppress(Exception):
            with open(CONFIG_PATH, "w") as fh:
                json.dump(stored, fh, indent=2)
                fh.write("\n")

    # ------------------------------------------------------------- worker ---

    def work(self):
        while not self.stopping.is_set():
            try:
                kind, payload = self.jobs.get(timeout=0.5)
            except queue.Empty:
                self.expire_follow_up()
                self.expire_overlay()
                continue
            try:
                if kind == "audio":
                    pcm, captured = payload
                    age = time.time() - captured
                    # Answering a question you asked fifteen seconds ago is
                    # worse than not answering it.
                    if age > self.cfg.get("maxSegmentAgeSeconds", 8):
                        self.dropped_segments += 1
                        log(f"  skipped a segment {age:.0f}s stale")
                        continue
                    self.handle_audio(pcm)
                elif kind == "wake":
                    self.begin_listening(manual=True)
                elif kind == "ask":
                    self.answer(payload, spoken=False)
                elif kind == "ask_spoken":
                    self.answer(payload, spoken=True)
                elif kind == "unguarded":
                    self.answer(payload, spoken=False, unguarded=True)
            except Exception as exc:
                log("worker:", exc)
                BUS.emit(t="error", message=str(exc)[:200])
                self.set_state(IDLE)

    def expire_overlay(self):
        if self.hide_at and time.time() > self.hide_at:
            self.hide_at = 0
            self.hide_ui()

    def expire_follow_up(self):
        if self.state == LISTENING and self.follow_until and time.time() > self.follow_until:
            self.follow_until = 0
            self.follow_turns = 0
            self.set_state(IDLE)
            if self.cfg.get("chime", True):
                play(os.path.join(self.sounds, "done.wav"))
            BUS.emit(t="sleep")

    def handle_audio(self, pcm):
        # With a real wake detector running, transcribing while idle buys
        # nothing and costs everything: in two and a half minutes of this
        # room it ran whisper forty-five times on noise, every one of them
        # discarded. The detector is the only thing that needs to be awake
        # between conversations.
        if (self.state == IDLE and self.wake.ready
                and not self.cfg.get("transcriptWakeFallback")):
            return
        seconds = len(pcm) / (SAMPLE_RATE * 2)
        started = time.time()
        text = self.whisper.transcribe(pcm, accurate=(self.state == LISTENING))
        took = time.time() - started
        no_speech = self.whisper.last_no_speech
        logprob = self.whisper.last_logprob
        log(f'heard[{self.state}] {seconds:.1f}s -> "{text}" '
            f'({took:.1f}s, no_speech={no_speech:.2f}, logprob={logprob:.2f})')

        # A transcript whisper is not confident in is noise wearing words.
        if text and (no_speech > self.cfg["maxNoSpeech"]
                     or logprob < self.cfg["minLogProb"]):
            log(f"  discarded as noise (no_speech={no_speech:.2f}, "
                f"logprob={logprob:.2f})")
            BUS.emit(t="noise", text=text, no_speech=round(no_speech, 3))
            return
        BUS.emit(t="transcript", text=text, seconds=round(seconds, 2),
                 state=self.state)
        if not text:
            if self.state == LISTENING:
                BUS.emit(t="misheard")
            return

        if self.state == LISTENING:
            self.follow_until = 0
            self.answer(text, spoken=True)
            return

        matched, remainder = wake_split(text, self.cfg)
        if not matched:
            log(f'  no wake match in "{normalize(text)}"')
            return
        BUS.emit(t="wake", heard=text)
        self.follow_turns = 0
        if self.whisper.last_language == "hi" and self.cfg.get("sttModelHindi"):
            # The cheap pass was enough to hear the name; the command itself
            # deserves the accurate model.
            better = self.whisper.transcribe(pcm, accurate=True)
            if better:
                matched2, remainder2 = wake_split(better, self.cfg)
                log(f'  re-read accurately -> "{better}"')
                if matched2:
                    remainder = remainder2

        if remainder and len(remainder.split()) >= 2:
            # "Juno, what's on my calendar" — one breath, one answer.
            self.answer(remainder, spoken=True, chime=True)
        else:
            self.begin_listening()

    def begin_listening(self, manual=False):
        self.follow_turns = 0
        if self.cfg.get("chime", True):
            play(os.path.join(self.sounds, "wake.wav"))
        self.set_state(LISTENING)
        self.follow_until = time.time() + self.cfg["followUpSeconds"]
        BUS.emit(t="awake", manual=manual)

    # ------------------------------------------------------------- answer ---

    def answer(self, prompt, spoken, unguarded=False, chime=False):
        if not self.claude.available():
            BUS.emit(t="error", message="The claude CLI is not installed.")
            play(os.path.join(self.sounds, "error.wav"))
            self.set_state(IDLE)
            return
        if chime and self.cfg.get("chime", True):
            play(os.path.join(self.sounds, "wake.wav"))
        self.last_prompt = prompt
        self.remember("user", prompt)
        BUS.emit(t="user", text=prompt)
        self.set_state(THINKING)

        # Speak while Claude is still writing. The microphone shuts before
        # the first sample rather than after the last token, so she cannot
        # hear her own opening sentence either.
        streaming = bool(spoken and self.cfg.get("speak", True)
                         and self.voice.available()
                         and self.cfg.get("streamSpeech", True))
        on_sentence = None
        if streaming and self.voice.begin_stream():
            self.tts_until = time.time() + 3600
            self.set_state(SPEAKING)

            def on_sentence(sentence):
                self.voice.feed(sentence)
        else:
            streaming = False

        try:
            reply = self.claude.ask(prompt, unguarded=unguarded,
                                    on_sentence=on_sentence)
        finally:
            if streaming:
                try:
                    self.voice.end_stream()
                finally:
                    self.tts_until = time.time() + float(
                        self.cfg.get("micReopenDelay", 1.4))

        if self.claude.cancelled:
            self.set_state(IDLE)
            return
        if not reply:
            play(os.path.join(self.sounds, "error.wav"))
            self.set_state(IDLE)
            return

        self.remember("assistant", reply)
        BUS.emit(t="assistant", text=reply)

        if not streaming and spoken and self.cfg.get("speak", True) \
                and self.voice.available():
            self.set_state(SPEAKING)
            self.say(reply)

        if self.cfg.get("chime", True):
            play(os.path.join(self.sounds, "done.wav"))

        if spoken and self.follow_turns < self.cfg["followUpMaxTurns"]:
            # Hold the floor briefly so a follow-up needs no wake word.
            self.follow_turns += 1
            self.set_state(LISTENING)
            self.follow_until = time.time() + self.cfg["followUpSeconds"]
            BUS.emit(t="listening_followup",
                     seconds=self.cfg["followUpSeconds"],
                     remaining=self.cfg["followUpMaxTurns"] - self.follow_turns)
        else:
            self.follow_turns = 0
            self.set_state(IDLE)
            if spoken:
                play(os.path.join(self.sounds, "done.wav"))
            BUS.emit(t="sleep")

    # --------------------------------------------------------------- run ---

    def run(self):
        log("juno: starting")
        self.whisper.start()
        self.wake.start()
        threading.Thread(target=self.voice.ensure, daemon=True).start()
        self.write_state_file()
        self.mic.start()
        threading.Thread(target=self.work, name="brain", daemon=True).start()
        BUS.emit(**self.snapshot())
        server = make_server(self)
        thread = threading.Thread(target=server.serve_forever, daemon=True)
        thread.start()
        log(f"juno: listening for '{self.cfg['wakeWord']}' — socket {SOCKET_PATH}")
        if not self.whisper.ready:
            log("juno: WARNING no speech model; text input still works")
        try:
            while not self.stopping.is_set():
                time.sleep(0.5)
        except KeyboardInterrupt:
            pass
        finally:
            self.shutdown(server)

    def shutdown(self, server=None):
        self.stopping.set()
        with contextlib.suppress(Exception):
            self.mic.stop()
        with contextlib.suppress(Exception):
            self.wake.stop()
        with contextlib.suppress(Exception):
            self.voice.teardown()
        with contextlib.suppress(Exception):
            self.whisper.stop()
        if server:
            with contextlib.suppress(Exception):
                server.shutdown()
        with contextlib.suppress(OSError):
            os.remove(SOCKET_PATH)
        with contextlib.suppress(OSError):
            os.remove(os.path.join(RUNTIME, "juno-state.json"))
        log("juno: stopped")


# --------------------------------------------------------------------- socket

def make_server(juno):
    class Handler(socketserver.StreamRequestHandler):
        def handle(self):
            q = queue.Queue(maxsize=256)
            BUS.add(q)
            stop = threading.Event()

            def writer():
                try:
                    self.wfile.write((json.dumps(juno.snapshot()) + "\n").encode())
                    self.wfile.flush()
                    while not stop.is_set():
                        try:
                            payload = q.get(timeout=0.4)
                        except queue.Empty:
                            continue
                        self.wfile.write(payload)
                        self.wfile.flush()
                except (BrokenPipeError, ConnectionResetError, ValueError, OSError):
                    pass
                finally:
                    stop.set()

            t = threading.Thread(target=writer, daemon=True)
            t.start()
            try:
                for line in self.rfile:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        juno.command(json.loads(line))
                    except json.JSONDecodeError:
                        pass
            except OSError:
                pass
            finally:
                stop.set()
                BUS.remove(q)

    class Server(socketserver.ThreadingUnixStreamServer):
        daemon_threads = True
        allow_reuse_address = True

    if os.path.exists(SOCKET_PATH):
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
                probe.settimeout(0.3)
                probe.connect(SOCKET_PATH)
            log("juno: another daemon already owns the socket")
            sys.exit(1)
        except OSError:
            os.remove(SOCKET_PATH)
    server = Server(SOCKET_PATH, Handler)
    os.chmod(SOCKET_PATH, 0o600)
    return server


def main():
    os.makedirs(STATE, exist_ok=True)
    juno = Juno()
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: juno.stopping.set())
    juno.run()


if __name__ == "__main__":
    main()
