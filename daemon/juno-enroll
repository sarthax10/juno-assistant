#!/home/sandbox/.local/share/juno/venv/bin/python
"""
Teach the wake word your voice.

The shipped wake models are trained on other people. Measured on this
machine, the same phrase spoken by this user scored 0.045 on one attempt and
0.410 on the next — usable on a good day, invisible on a bad one, and no
threshold fixes that spread.

This records you saying the phrase, records the room you say it in, and
fits a classifier on top of the same speech embeddings the shipped models
use. It is training in the ordinary sense: your positives, your room's
negatives, a held-out split to check it generalised. It takes a couple of
minutes and runs entirely on the CPU, because the embedding model does the
heavy lifting and the part being learned is small.
"""

import json
import os
import subprocess
import sys
import time
import wave

import numpy as np
from openwakeword.utils import AudioFeatures
from sklearn.linear_model import LogisticRegression
from sklearn.model_selection import cross_val_score

SHARE = os.path.expanduser("~/.local/share/juno")
CFG = os.path.expanduser("~/.config/juno/config.json")
OUT = os.path.join(SHARE, "personal-wake.npz")
CLIPS = os.path.join(SHARE, "enrollment")
RATE = 16000
CLIP_SECONDS = 2.0
SAMPLES = int(RATE * CLIP_SECONDS)


def record(seconds):
    proc = subprocess.Popen(
        ["timeout", str(seconds + 1), "pw-record", "--raw", "--rate", str(RATE),
         "--channels", "1", "--format", "s16", "-"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    raw = proc.stdout.read()
    proc.wait()
    return np.frombuffer(raw, dtype=np.int16)


def level(audio):
    if len(audio) == 0:
        return 0.0
    return float(np.sqrt(np.mean(audio.astype(np.float64) ** 2)) / 32768)


def centre_on_speech(audio, floor):
    """Trim to the loudest CLIP_SECONDS window. The classifier should learn
    the phrase, not where in the recording you happened to start talking."""
    if len(audio) <= SAMPLES:
        return np.pad(audio, (0, SAMPLES - len(audio)))
    step = RATE // 20
    best, best_energy = 0, -1.0
    for start in range(0, len(audio) - SAMPLES, step):
        energy = float(np.mean(np.abs(audio[start:start + SAMPLES].astype(np.float64))))
        if energy > best_energy:
            best, best_energy = start, energy
    return audio[best:best + SAMPLES]


def augment(clip, noises, rng):
    """One recording becomes several, so a dozen takes is enough data.

    The variations are the ones that actually happen: you speak at different
    volumes, stand at different distances, and the room is never the same
    twice.
    """
    out = [clip]
    for gain in (0.6, 1.4):
        out.append(np.clip(clip.astype(np.float32) * gain, -32768, 32767).astype(np.int16))
    for shift in (-RATE // 8, RATE // 8):
        out.append(np.roll(clip, shift))
    for _ in range(3):
        if len(noises) == 0:
            break
        noise = noises[rng.integers(len(noises))]
        mix = clip.astype(np.float32) + noise.astype(np.float32) * rng.uniform(0.3, 0.9)
        out.append(np.clip(mix, -32768, 32767).astype(np.int16))
    return out


def main():
    cfg = json.load(open(CFG)) if os.path.exists(CFG) else {}
    phrase = f"Hey {cfg.get('wakeWord', 'Jarvis')}"
    takes = int(sys.argv[1]) if len(sys.argv) > 1 else 12
    os.makedirs(CLIPS, exist_ok=True)
    rng = np.random.default_rng(0)

    print(f'Teaching the wake word your voice. Phrase: "{phrase}"')
    print(f"{takes} short recordings, then about a minute of listening to your room.\n")

    print("First, hold still and stay quiet for 20 seconds so it learns what")
    print("your room sounds like when you are not talking.")
    input("Press Enter when ready... ")
    room = record(20)
    floor = level(room)
    print(f"  room level {floor:.4f}\n")

    noises = [room[i:i + SAMPLES] for i in range(0, len(room) - SAMPLES, SAMPLES)]

    positives = []
    take = 0
    while take < takes:
        input(f'[{take + 1}/{takes}] Press Enter, then say "{phrase}" once... ')
        clip = record(3)
        peak = float(np.max(np.abs(clip))) / 32768 if len(clip) else 0
        if peak < max(floor * 3, 0.02):
            print("  too quiet — nothing clearly above the room. Again.\n")
            continue
        centred = centre_on_speech(clip, floor)
        positives.append(centred)
        with wave.open(os.path.join(CLIPS, f"take{take:02d}.wav"), "wb") as w:
            w.setnchannels(1); w.setsampwidth(2); w.setframerate(RATE)
            w.writeframes(centred.tobytes())
        print(f"  captured (peak {peak:.3f})\n")
        take += 1

    print("Now say anything EXCEPT the wake phrase for 30 seconds — count,")
    print("read something out, talk normally. This teaches it what to ignore.")
    input("Press Enter when ready... ")
    speech = record(30)
    other = [speech[i:i + SAMPLES] for i in range(0, len(speech) - SAMPLES, SAMPLES // 2)]

    print("\nTraining...")
    af = AudioFeatures()

    pos = []
    for clip in positives:
        pos.extend(augment(clip, noises, rng))
    neg = noises + other
    # Silence is a negative too, and a cheap one.
    neg.append(np.zeros(SAMPLES, dtype=np.int16))

    pos = np.array([p[:SAMPLES] for p in pos if len(p) >= SAMPLES])
    neg = np.array([n[:SAMPLES] for n in neg if len(n) >= SAMPLES])
    print(f"  {len(pos)} positive windows (from {len(positives)} takes), {len(neg)} negative")

    X = np.concatenate([
        np.array(af.embed_clips(pos, batch_size=8)).reshape(len(pos), -1),
        np.array(af.embed_clips(neg, batch_size=8)).reshape(len(neg), -1),
    ])
    y = np.concatenate([np.ones(len(pos)), np.zeros(len(neg))])

    model = LogisticRegression(max_iter=3000, C=0.5, class_weight="balanced")
    scores = cross_val_score(model, X, y, cv=min(5, len(positives)), scoring="roc_auc")
    model.fit(X, y)
    print(f"  held-out ROC AUC: {scores.mean():.3f} (+/- {scores.std():.3f})")

    # Pick the operating point on the enrolled data: the lowest score any of
    # your own takes got, with a margin.
    own = model.decision_function(X[:len(pos)])
    threshold = float(np.percentile(own, 10))
    np.savez(OUT, coef=model.coef_[0], intercept=model.intercept_,
             threshold=threshold, phrase=phrase)
    print(f"\nSaved to {OUT}")
    print(f"  decision threshold {threshold:.2f}")
    print("\nRestarting the service...")
    subprocess.run(["systemctl", "--user", "restart", "juno.service"])
    print(f'Done. Say "{phrase}".')
    return 0


if __name__ == "__main__":
    sys.exit(main())
